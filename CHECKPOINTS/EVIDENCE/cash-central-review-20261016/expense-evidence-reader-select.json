  "method": "Render read-only connector; exact generated shared-reader aggregate plus separately scoped active transaction/week SELECT. No production scripts or business writes.",
  "aggregateSQL": "\n        SELECT p.\"id\",p.\"documentNumber\",p.\"status\" AS \"documentStatus\",p.\"totalGross\" AS \"documentTotal\",\n          a.\"paymentCount\",a.\"invalidPaymentCount\",a.\"documentPaymentTotal\",a.\"cashPaymentTotal\",a.\"externalPaymentTotal\"\n        FROM \"PurchaseDocument\" p\n        CROSS JOIN LATERAL (\n          SELECT COUNT(*)::int AS \"paymentCount\",\n            COUNT(*) FILTER (WHERE NOT COALESCE(t.\"amount\">0 AND t.\"amount\"::text NOT IN ('NaN','Infinity','-Infinity') AND t.\"amount\"=ROUND(t.\"amount\",2) AND t.\"subtractFromShift\" IS NOT NULL AND (t.\"subtractFromShift\"=false OR t.\"sessionId\" IS NOT NULL),false))::int AS \"invalidPaymentCount\",\n            COALESCE(SUM(t.\"amount\"),0) AS \"documentPaymentTotal\",\n            COALESCE(SUM(t.\"amount\") FILTER (WHERE t.\"subtractFromShift\"=true),0) AS \"cashPaymentTotal\",\n            COALESCE(SUM(t.\"amount\") FILTER (WHERE t.\"subtractFromShift\"=false),0) AS \"externalPaymentTotal\"\n          FROM \"StoreTransaction\" t\n          WHERE t.\"companyId\"=p.\"companyId\" AND t.\"storeId\"=p.\"storeId\"\n            AND t.\"attachmentMimeType\"='application/vnd.myworkstation.purchase-document' AND t.\"attachmentFilename\"=p.\"id\"\n            AND t.\"type\" IN ('SUPPLIER_PAYMENT','OTHER_EXPENSE') AND t.\"reversedAt\" IS NULL\n        ) a\n        WHERE p.\"companyId\"='cmtpopbgk000prhb5qc60zxus' AND p.\"storeId\"='cmtpopbgo000trhb5ng9ytiru' AND p.\"id\"=ANY(ARRAY['expense_2ad4fc2f0deeee8ca96f5df67139b3755e207cb2d509c14a5a9493ccf025043a','expense_70b2dde6b29f75ad7fbdf782f1c26ec970c409886556d4f17c6711ebbf92a167']::text[])",
  "sourceSQL": "SELECT json_build_object('observedAt',CURRENT_TIMESTAMP,'transactions',(SELECT json_agg(x) FROM (SELECT t.\"id\",t.\"sessionId\",t.\"type\",t.\"amount\",t.\"subtractFromShift\",t.\"occurredAt\",(t.\"attachmentData\" IS NOT NULL) AS \"hasAttachment\",CASE WHEN t.\"attachmentMimeType\"='application/vnd.myworkstation.purchase-document' THEN t.\"attachmentFilename\" ELSE NULL END AS \"purchaseDocumentId\" FROM \"StoreTransaction\" t WHERE t.\"companyId\"='cmtpopbgk000prhb5qc60zxus' AND t.\"storeId\"='cmtpopbgo000trhb5ng9ytiru' AND t.\"type\" IN ('SUPPLIER_PAYMENT','OTHER_EXPENSE') AND t.\"reversedAt\" IS NULL AND ((t.\"subtractFromShift\"=true AND t.\"sessionId\" IN ('865e6a48-ccbe-4238-8580-6d70682050a5','88e654a5-9cf6-47da-bcb7-b4e16b1744ca')) OR (t.\"attachmentMimeType\"='application/vnd.myworkstation.purchase-document' AND t.\"attachmentFilename\" IN ('expense_2ad4fc2f0deeee8ca96f5df67139b3755e207cb2d509c14a5a9493ccf025043a','expense_70b2dde6b29f75ad7fbdf782f1c26ec970c409886556d4f17c6711ebbf92a167'))) ORDER BY t.\"occurredAt\",t.\"id\") x),'week',(SELECT json_agg(x) FROM (SELECT \"id\",\"terminalPos\",\"closedAt\",\"variance\",\"expenses\" FROM \"CashShiftSession\" WHERE \"companyId\"='cmtpopbgk000prhb5qc60zxus' AND \"storeId\"='cmtpopbgo000trhb5ng9ytiru' AND \"status\"='CLOSED' AND (\"closedAt\" AT TIME ZONE 'Europe/Athens')::date BETWEEN '2026-10-12'::date AND '2026-10-18'::date ORDER BY \"closedAt\") x)) AS evidence",
